{
	"name": "smart-community-app-generator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"description": "AI-workflow-driven generator for community sustainability apps with built-in contribution-reward loops.",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@langchain/anthropic": "^0.3.0",
		"@langchain/aws": "^0.1.0",
		"@langchain/core": "^0.3.0",
		"@langchain/google-genai": "^0.2.0",
		"@langchain/langgraph": "^0.2.0",
		"@langchain/openai": "^0.3.0",
		"@langchain/xai": "^0.0.2",
		"@tanstack/react-query": "^5.59.0",
		"mermaid": "^11.4.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.10.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vercel/node": "^5.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"jsdom": "^25.0.1",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.2",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	}
}
