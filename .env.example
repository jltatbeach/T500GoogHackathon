# =============================================================================
# Smart Community App Generator — environment configuration
#
# Copy to `.env` and fill in keys for the provider(s) you want to use.
# `.env` is git-ignored; NEVER commit real keys.
#
# Provider env var names and default models mirror the smart-assets.io
# /multi-review wiring so credentials are reusable across tools.
# =============================================================================

# Which provider the LangGraph agents target: anthropic | openai | xai | google | bedrock
LLM_PROVIDER=google

# --- Google Gemini (default) -------------------------------------------------
# GEMINI_API_KEY or GOOGLE_API_KEY
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# --- Anthropic Claude --------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-5-20251101

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4-turbo

# --- xAI Grok ----------------------------------------------------------------
# XAI_API_KEY or GROK_API_KEY
XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning

# --- Amazon Bedrock (Nova) ---------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# BEDROCK_MODEL=us.amazon.nova-pro-v1:0
